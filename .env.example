# Set both to enable contact-form email delivery. Otherwise an email draft is offered.
RESEND_API_KEY=
# Must be a sender verified in your Resend account, for example:
CONTACT_FROM_EMAIL=Nicholas Gould Photography <hello@nicholasgouldphoto.com>

# Preview remains noindex unless every launch gate is explicitly enabled.
# See docs/seo-launch.md. Never enable these as part of a preview deployment.
SEO_LAUNCH_INDEXING=false
SEO_CANONICAL_ORIGIN=
SEO_PUBLIC_ORIGIN=

# Commerce intentionally remains unavailable without an approved durable adapter.
# Configuration contracts and activation prerequisites: docs/commerce-sdk-integration.md
